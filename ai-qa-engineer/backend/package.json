{
  "name": "ai-qa-engineer-backend",
  "version": "1.0.0",
  "description": "Backend for AI QA Engineer using Express, Playwright, and Google Generative AI",
  "main": "server.ts",
  "scripts": {
    "start": "ts-node server.ts",
    "dev": "ts-node-dev --respawn --transpile-only server.ts",
    "test:generated": "playwright test"
  },
  "dependencies": {
    "@google/genai": "latest",
    "@playwright/test": "latest",
    "axios": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "playwright": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "ts-node": "latest",
    "ts-node-dev": "latest",
    "typescript": "latest"
  }
}
